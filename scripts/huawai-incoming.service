# System unit (root): loads every /etc/huawai/*.nft at boot (mullvad-incoming.nft,
# port443.nft; each optional), removes their tables on stop. Install: see
# docs/USAGE.md, remote access from another network.
[Unit]
Description=Huawai: incoming calls of the tablet (Mullvad exception, port 443 redirect)
After=network-pre.target mullvad-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for f in /etc/huawai/*.nft; do [ -e "$f" ] || continue; /usr/sbin/nft -f "$f" || exit 1; done'
ExecStop=/bin/sh -c '/usr/sbin/nft delete table inet huawai_incoming 2>/dev/null; /usr/sbin/nft delete table inet huawai_port443 2>/dev/null; true'

[Install]
WantedBy=multi-user.target
