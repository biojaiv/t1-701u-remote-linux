# Defaults for the tablet (there is no dconf: gsettings keeps changes only in
# memory, so the defaults are what counts). Compiled by setup.sh ui.

# onboard: appears by itself at text fields (needs at-spi2), docked at the
# bottom like a phone keyboard, dark, no tray icon (there is no tray)
[org.onboard]
layout='Compact'
theme='Nightshade'
show-status-icon=false
start-minimized=true

[org.onboard.auto-show]
enabled=true
# do not move windows out of its way: with matchbox, moving and resizing the
# full-screen program on every show and hide fed focus changes back to
# auto-show; hiding the keyboard then made it blink instead of going away
reposition-method-docked='none'
reposition-method-floating='none'

[org.onboard.window]
docking-enabled=true
docking-edge='bottom'
# lies over the program instead of shrinking it (see above)
docking-shrink-workarea=false
force-to-top=true

[org.onboard.window.landscape]
dock-expand=true

[org.onboard.icon-palette]
in-use=false
