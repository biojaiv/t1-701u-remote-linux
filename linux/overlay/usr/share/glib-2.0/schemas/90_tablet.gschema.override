# Defaults for the tablet. Compiled by setup.sh ui. dconf is installed: a
# value a program saves there (for example after moving the keyboard button)
# wins over these defaults.

# onboard: opened and closed with the "ABC" tab at the right edge
# (tablet-keyboard-tab, over onboard's D-Bus), a floating window across the bottom of the screen, dark, no tray icon (there
# is no tray). Neither auto-show nor docking: with matchbox, the docked
# keyboard mapped and unmapped its window about six times a second (recorded
# with xev, 2026-11-18), seen as fast blinking after closing it; floating at
# the same place it maps once and unmaps once (tested over onboard's D-Bus).
[org.onboard]
layout='Compact'
theme='Nightshade'
show-status-icon=false
start-minimized=true

[org.onboard.auto-show]
enabled=false
# in case auto-show is switched on again: do not move windows out of its way
# (moving the full-screen program fed focus changes back to auto-show)
reposition-method-docked='none'
reposition-method-floating='none'

[org.onboard.window]
docking-enabled=false
docking-shrink-workarea=false
force-to-top=true
# no frame handles: a finger would move or resize it by accident
window-handles=''

# 1024x600 screen (landscape) or 600x1024: the keyboard over the bottom part
[org.onboard.window.landscape]
x=0
y=395
width=1024
height=205

[org.onboard.window.portrait]
x=0
y=819
width=600
height=205

# onboard's own floating button: replaced by the "ABC" tab
[org.onboard.icon-palette]
in-use=false
